{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPSC Bundle",
  "version": "0.1.0",
  "identifier": "com.ovfor4.cpsc-bundle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "CPSC Bundle", "width": 1000, "height": 760, "minWidth": 640, "minHeight": 440, "backgroundColor": "#1e1e1e" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["app"],
    "externalBin": ["binaries/cpsc"],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../ThirdPartyNotices.md": "ThirdPartyNotices.md",
      "../../plugin/ThirdPartyNotices.md": "licenses/plugin.md",
      "../vendor/vscode/LICENSE.txt": "licenses/vscode.txt",
      "../node_modules/monaco-editor/LICENSE": "licenses/monaco-editor.txt",
      "../node_modules/vscode-textmate/LICENSE.md": "licenses/vscode-textmate.txt",
      "../node_modules/vscode-oniguruma/LICENSE.txt": "licenses/vscode-oniguruma.txt",
      "../node_modules/jsonc-parser/LICENSE.md": "licenses/jsonc-parser.txt",
      "../node_modules/@tauri-apps/api/LICENSE-MIT": "licenses/tauri-mit.txt",
      "../node_modules/@tauri-apps/api/LICENSE-APACHE-2.0": "licenses/tauri-apache.txt"
    },
    "macOS": { "minimumSystemVersion": "15.0" }
  }
}
