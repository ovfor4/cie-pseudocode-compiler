CLASS Key
Value : INTEGER
OVERLOAD FUNCTION OPERATOR=(rhs : Key) RETURNS BOOLEAN
RETURN Value = rhs.Value
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR>=(rhs : Key) RETURNS BOOLEAN
RETURN Value >= rhs.Value
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR<=(rhs : Key) RETURNS BOOLEAN
RETURN Value <= rhs.Value
ENDFUNCTION
ENDCLASS
