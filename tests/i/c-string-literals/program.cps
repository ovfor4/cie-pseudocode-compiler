DECLARE Text : C_STRING
Text <- "quote:\" slash:\\"C
OUTPUT (STRING)Text
OUTPUT (STRING)"\101\x42"C
CONSTANT Empty = ""C
OUTPUT LENGTH((STRING)Empty)
OVERLOAD FUNCTION Kind(Text : STRING) RETURNS INTEGER
    RETURN 1
ENDFUNCTION
OVERLOAD FUNCTION Kind(Text : C_STRING) RETURNS INTEGER
    RETURN 2
ENDFUNCTION
OUTPUT Kind("text"), ":", Kind("text"C)
