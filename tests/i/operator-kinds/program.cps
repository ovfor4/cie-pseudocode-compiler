TYPE Choice = (First, Second)
OVERLOAD FUNCTION OPERATOR +(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 101
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR -(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 102
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR *(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 103
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR /(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 104
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR DIV(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 105
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR MOD(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 106
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR &(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 107
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR =(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 108
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR <>(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 109
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR <(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 110
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR <=(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 111
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR >(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 112
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR >=(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 113
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR AND(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 114
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR OR(lhs : Choice, rhs : Choice) RETURNS INTEGER
RETURN 115
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR-(value : Choice) RETURNS INTEGER
RETURN 116
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR NOT(value : Choice) RETURNS INTEGER
RETURN 117
ENDFUNCTION
OUTPUT First + Second
OUTPUT First - Second
OUTPUT First * Second
OUTPUT First / Second
OUTPUT First DIV Second
OUTPUT First MOD Second
OUTPUT First & Second
OUTPUT First = Second
OUTPUT First <> Second
OUTPUT First < Second
OUTPUT First <= Second
OUTPUT First > Second
OUTPUT First >= Second
OUTPUT First AND Second
OUTPUT First OR Second
OUTPUT -First
OUTPUT NOT Second
OUTPUT OPERATOR AND(First, Second)
