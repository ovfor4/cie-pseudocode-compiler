CONSTANT Minimum = -9223372036854775808
CONSTANT Maximum = 9223372036854775807
DECLARE Values : ARRAY[-9223372036854775808:-9223372036854775808] OF INTEGER
Values[Minimum] <- Maximum
CALL Show(Values)
OUTPUT Minimum, ":", Maximum
OUTPUT -0, ":", -1, ":", -(1 + 2)
PROCEDURE Show(BYREF Items : ARRAY[-9223372036854775808:-9223372036854775808] OF INTEGER)
    OUTPUT Items[-9223372036854775808]
ENDPROCEDURE
