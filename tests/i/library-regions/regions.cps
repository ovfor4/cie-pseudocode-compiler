PROCEDURE Mixed()
PP_DEFINE __LIB
TRY
    OUTPUT 1 DIV 0
CATCH
    OUTPUT 1
ENDTRY
PP_UNDEF __LIB
TRY
    OUTPUT 1 DIV 0
CATCH
    OUTPUT 2
ENDTRY
TRY
    CALL LibraryError()
CATCH
    OUTPUT 3
ENDTRY
PP_IFDEF Never
PP_DEFINE __LIB
PP_ENDIF
TRY
    OUTPUT 1 DIV 0
CATCH
    OUTPUT 4
ENDTRY
ENDPROCEDURE
PP_DEFINE __LIB
PROCEDURE LibraryError()
    CALL NestedError()
ENDPROCEDURE
PROCEDURE NestedError()
    OUTPUT 1 DIV 0
ENDPROCEDURE
TEMPLATE <T>
PROCEDURE TemplateError()
    OUTPUT 1 DIV 0
ENDPROCEDURE
CLASS DeleteError
    PROCEDURE DELETE()
        OUTPUT 1 DIV 0
    ENDPROCEDURE
ENDCLASS
PROCEDURE DeleteOnExit()
    DECLARE X : DeleteError
ENDPROCEDURE
PP_UNDEF __LIB
