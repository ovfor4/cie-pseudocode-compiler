CLASS STRING
    Text : C_STRING
    IMPLICIT PROCEDURE NEW(Value : C_STRING)
        Text <- Value
    ENDPROCEDURE
    FUNCTION C_STR() RETURNS C_STRING
        RETURN Text
    ENDFUNCTION
ENDCLASS
FUNCTION LENGTH(Value : INTEGER) RETURNS INTEGER
    RETURN Value + 1
ENDFUNCTION
OUTPUT "custom STRING", ":", LENGTH(41)
