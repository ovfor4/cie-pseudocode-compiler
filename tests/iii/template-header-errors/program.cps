TEMPLATE <T, t>
FUNCTION Duplicate(Value : T) RETURNS T
    RETURN Value
ENDFUNCTION

TEMPLATE <Rest..., T>
PROCEDURE NotLast()
ENDPROCEDURE

TEMPLATE <A..., B...>
PROCEDURE TwoPacks()
ENDPROCEDURE

TEMPLATE <T>
TYPE Alias = ^T

TEMPLATE <T>
OVERLOAD FUNCTION OPERATOR+(Value : T) RETURNS T
    RETURN Value
ENDFUNCTION

IF TRUE THEN
    TEMPLATE <T>
    PROCEDURE Nested(Value : T)
        OUTPUT 99
    ENDPROCEDURE
ENDIF

CLASS Outer
    TEMPLATE <T>
    PROCEDURE Member(Value : T)
    ENDPROCEDURE
ENDCLASS

TEMPLATE <>
PROCEDURE Empty()
ENDPROCEDURE

OUTPUT 0
