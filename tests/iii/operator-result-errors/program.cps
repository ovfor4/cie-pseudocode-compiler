CLASS Box
Value : INTEGER
OVERLOAD FUNCTION OPERATOR=(rhs : Box) RETURNS STRING
RETURN "text"
ENDFUNCTION
ENDCLASS
DECLARE item : Box
IF item = item THEN
OUTPUT "wrong"
ENDIF
FUNCTION Bad(value : Box) RETURNS BOOLEAN
RETURN value = value
ENDFUNCTION
FUNCTION NeedBool(flag : BOOLEAN) RETURNS INTEGER
RETURN 0
ENDFUNCTION
OUTPUT NeedBool(item = item)
CASE OF item
item : OUTPUT "wrong"
ENDCASE
