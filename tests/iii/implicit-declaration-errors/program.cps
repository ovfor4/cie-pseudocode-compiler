CLASS Invalid
    IMPLICIT PROCEDURE NEW()
    ENDPROCEDURE
ENDCLASS
CLASS RefInvalid
    IMPLICIT PROCEDURE NEW(BYREF Value : INTEGER)
    ENDPROCEDURE
ENDCLASS
CLASS ArrayInvalid
    IMPLICIT PROCEDURE NEW(Value : ARRAY OF INTEGER)
    ENDPROCEDURE
ENDCLASS
CLASS MethodInvalid
    IMPLICIT PROCEDURE Convert(Value : INTEGER)
    ENDPROCEDURE
ENDCLASS
CLASS PairInvalid
    IMPLICIT PROCEDURE NEW(A : INTEGER, B : INTEGER)
    ENDPROCEDURE
ENDCLASS
OUTPUT 1
