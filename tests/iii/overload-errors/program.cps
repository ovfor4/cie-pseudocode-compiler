OVERLOAD FUNCTION Mixed(x : INTEGER) RETURNS INTEGER
RETURN x
ENDFUNCTION
FUNCTION Mixed(x : REAL) RETURNS REAL
RETURN x
ENDFUNCTION
OVERLOAD FUNCTION Ret(x : INTEGER) RETURNS INTEGER
RETURN x
ENDFUNCTION
OVERLOAD FUNCTION Ret(x : INTEGER) RETURNS REAL
RETURN x
ENDFUNCTION
OVERLOAD PROCEDURE Mode(BYREF x : INTEGER)
ENDPROCEDURE
OVERLOAD PROCEDURE Mode(BYVAL x : INTEGER)
ENDPROCEDURE
OVERLOAD FUNCTION Exact(x : REAL) RETURNS REAL
RETURN x
ENDFUNCTION
OUTPUT Exact(1)
OVERLOAD PROCEDURE Bounds(a : ARRAY[1:2] OF INTEGER)
ENDPROCEDURE
OVERLOAD PROCEDURE Bounds(a : ARRAY[3:4] OF INTEGER)
ENDPROCEDURE
OVERLOAD FUNCTION LENGTH(x : INTEGER) RETURNS INTEGER
RETURN x
ENDFUNCTION
OUTPUT Exact("text")
OUTPUT Exact()
