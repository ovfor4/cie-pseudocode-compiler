CLASS Box
Value : INTEGER
OVERLOAD FUNCTION OPERATOR+(rhs : Box) RETURNS INTEGER
RETURN 1
ENDFUNCTION
PRIVATE OVERLOAD FUNCTION OPERATOR&(rhs : STRING) RETURNS STRING
RETURN rhs
ENDFUNCTION
ENDCLASS
OVERLOAD FUNCTION OPERATOR+(lhs : Box, rhs : Box) RETURNS INTEGER
RETURN 2
ENDFUNCTION
DECLARE a : Box
OUTPUT a + a
OUTPUT a & "x"
OUTPUT a.OPERATOR&("x")
DECLARE items : ARRAY[1:2] OF Box
OUTPUT NOT items
