TEMPLATE <T>
FUNCTION Max(A : T, B : T) RETURNS T
    RETURN A
ENDFUNCTION

FUNCTION Plain(Value : INTEGER) RETURNS INTEGER
    RETURN Value
ENDFUNCTION

TEMPLATE <A>
OVERLOAD FUNCTION Tied(Value : A) RETURNS INTEGER
    RETURN 1
ENDFUNCTION
TEMPLATE <B>
OVERLOAD FUNCTION Tied(Value : B) RETURNS INTEGER
    RETURN 2
ENDFUNCTION

OUTPUT Max<INTEGER, REAL>(1, 2)
OUTPUT Max<REAL>(1, 2.5)
OUTPUT Plain<INTEGER>(1)
OUTPUT EOF<STRING>("file.txt")
CALL MALLOC<INTEGER>(8)
OUTPUT Tied<INTEGER>(1)
