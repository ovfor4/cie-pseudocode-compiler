TYPE Box
DECLARE Value : INTEGER
ENDTYPE
OVERLOAD FUNCTION OPERATOR+(a : Box, b : REAL) RETURNS INTEGER
RETURN 1
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR<(a : Box, b : Box) RETURNS STRING
RETURN "text"
ENDFUNCTION
DECLARE a : Box
DECLARE flag : BOOLEAN
flag <- a < a
OUTPUT a + 1
OVERLOAD FUNCTION OPERATOR&(a : INTEGER, b : INTEGER) RETURNS INTEGER
RETURN b
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR*(a : Box) RETURNS INTEGER
RETURN 1
ENDFUNCTION
OVERLOAD FUNCTION OPERATOR+(a : Box, b : REAL) RETURNS REAL
RETURN 2.0
ENDFUNCTION
