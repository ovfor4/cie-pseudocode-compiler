CLASS Mixed
OVERLOAD PROCEDURE Set(x : INTEGER)
ENDPROCEDURE
PROCEDURE Set(x : STRING)
ENDPROCEDURE
ENDCLASS
CLASS Required
OVERLOAD PROCEDURE NEW(x : INTEGER)
ENDPROCEDURE
ENDCLASS
CLASS Secret
PRIVATE OVERLOAD PROCEDURE Set(x : INTEGER)
ENDPROCEDURE
PUBLIC OVERLOAD PROCEDURE Set(x : STRING)
ENDPROCEDURE
ENDCLASS
DECLARE item : Required
DECLARE obj : Secret
CALL obj.Set(1)
CALL obj.Set(TRUE)
