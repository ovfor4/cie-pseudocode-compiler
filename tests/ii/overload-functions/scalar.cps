OVERLOAD FUNCTION Score(X : INTEGER) RETURNS INTEGER
    RETURN 3 * X + 1
ENDFUNCTION
OVERLOAD FUNCTION Score(X : REAL) RETURNS BOOLEAN
    RETURN X < 0.0
ENDFUNCTION
OVERLOAD FUNCTION Score(Text : STRING) RETURNS INTEGER
    RETURN LENGTH(Text) + 100
ENDFUNCTION
OVERLOAD FUNCTION Score(X : INTEGER, Y : INTEGER) RETURNS INTEGER
    RETURN 17 * X + Y
ENDFUNCTION
OVERLOAD PROCEDURE Score(BYREF Value : INTEGER, BYVAL Delta : INTEGER, Repetitions : INTEGER)
    Value <- Value + Delta * Repetitions
ENDPROCEDURE
