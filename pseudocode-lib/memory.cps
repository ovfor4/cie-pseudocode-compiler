PP_DEFINE __LIB
INCLUDE_OBJ "memory.o"
TYPE _MEMORY_ADDRESS = C_TYPE("void*")
TYPE _MEMORY_SIZE = C_TYPE("unsigned long long")
TYPE _MEMORY_C_BOOL = C_TYPE("_Bool")
TYPE _MEMORY_C_SIGNED_CHAR = C_TYPE("signed char")
TYPE _MEMORY_C_UNSIGNED_CHAR = C_TYPE("unsigned char")
TYPE _MEMORY_C_SHORT = C_TYPE("short")
TYPE _MEMORY_C_UNSIGNED_SHORT = C_TYPE("unsigned short")
TYPE _MEMORY_C_UNSIGNED_INT = C_TYPE("unsigned int")
TYPE _MEMORY_C_LONG = C_TYPE("long")
TYPE _MEMORY_C_UNSIGNED_LONG = C_TYPE("unsigned long")
TYPE _MEMORY_C_LONG_LONG = C_TYPE("long long")
EXTERN "C" EXTERN_FUNCTION _memory_impl_malloc(_MEMORY_SIZE) RETURNS _MEMORY_ADDRESS
EXTERN "C" EXTERN_FUNCTION _memory_impl_realloc(_MEMORY_ADDRESS, _MEMORY_SIZE) RETURNS _MEMORY_ADDRESS
EXTERN "C" EXTERN_FUNCTION _memory_impl_free(_MEMORY_ADDRESS) RETURNS _MEMORY_ADDRESS
EXTERN "C" EXTERN_PROCEDURE _memory_impl_validate(_MEMORY_ADDRESS)

OVERLOAD FUNCTION MALLOC(Bytes : INTEGER) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : INTEGER) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_BOOL) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_BOOL) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : C_CHAR) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : C_CHAR) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_SIGNED_CHAR) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_SIGNED_CHAR) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_UNSIGNED_CHAR) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_UNSIGNED_CHAR) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_SHORT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_SHORT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_UNSIGNED_SHORT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_UNSIGNED_SHORT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : C_INT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : C_INT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_UNSIGNED_INT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_UNSIGNED_INT) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_LONG) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_LONG) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_UNSIGNED_LONG) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_UNSIGNED_LONG) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_C_LONG_LONG) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_C_LONG_LONG) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION MALLOC(Bytes : _MEMORY_SIZE) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_malloc((_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION REALLOC(Address : _MEMORY_ADDRESS, Bytes : _MEMORY_SIZE) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_realloc(Address, (_MEMORY_SIZE)Bytes)
ENDFUNCTION
OVERLOAD FUNCTION FREE(Address : _MEMORY_ADDRESS) RETURNS _MEMORY_ADDRESS
    RETURN _memory_impl_free(Address)
ENDFUNCTION
