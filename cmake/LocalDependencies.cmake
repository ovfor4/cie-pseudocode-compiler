set(CPSC_DEPS_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(CPSC_DEPS_DIR "${CMAKE_BINARY_DIR}/deps")
set(CPSC_DEPS_ROOT "${CPSC_DEPS_DIR}/root")
include("${CPSC_DEPS_MODULE_DIR}/ExtractPackages.cmake")
include("${CPSC_DEPS_MODULE_DIR}/LinuxPackages.cmake")
include("${CPSC_DEPS_MODULE_DIR}/WindowsPackages.cmake")
include("${CPSC_DEPS_MODULE_DIR}/HomebrewPackages.cmake")
cpsc_extract_packages()

set(cpsc_local_prefixes)
foreach(prefix "${CPSC_DEPS_ROOT}/usr" "${CPSC_DEPS_ROOT}/mingw64"
        "${CPSC_DEPS_ROOT}/ucrt64" "${CPSC_DEPS_ROOT}/clang64")
    if(IS_DIRECTORY "${prefix}")
        list(APPEND cpsc_local_prefixes "${prefix}")
    endif()
endforeach()
file(GLOB llvm_prefixes LIST_DIRECTORIES TRUE "${CPSC_DEPS_ROOT}/usr/lib/llvm-*")
file(GLOB brew_prefixes LIST_DIRECTORIES TRUE "${CPSC_DEPS_ROOT}/opt/*")
list(APPEND cpsc_local_prefixes ${llvm_prefixes} ${brew_prefixes})

set(CPSC_LOCAL_LIBRARY_DIRS)
set(CPSC_LOCAL_INCLUDE_DIRS)
set(CPSC_LOCAL_BIN_DIRS)
foreach(prefix IN LISTS cpsc_local_prefixes)
    list(APPEND CPSC_LOCAL_LIBRARY_DIRS "${prefix}/lib")
    list(APPEND CPSC_LOCAL_INCLUDE_DIRS "${prefix}/include")
    list(APPEND CPSC_LOCAL_INCLUDE_DIRS "${prefix}/include/libxml2")
    list(APPEND CPSC_LOCAL_BIN_DIRS "${prefix}/bin")
endforeach()
if(CMAKE_LIBRARY_ARCHITECTURE)
    list(INSERT CPSC_LOCAL_LIBRARY_DIRS 0
        "${CPSC_DEPS_ROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}"
        "${CPSC_DEPS_ROOT}/lib/${CMAKE_LIBRARY_ARCHITECTURE}")
    list(APPEND CPSC_LOCAL_INCLUDE_DIRS
        "${CPSC_DEPS_ROOT}/usr/include/${CMAKE_LIBRARY_ARCHITECTURE}")
endif()
if(cpsc_local_prefixes)
    list(INSERT CMAKE_PREFIX_PATH 0 ${cpsc_local_prefixes})
endif()
list(INSERT CMAKE_LIBRARY_PATH 0 ${CPSC_LOCAL_LIBRARY_DIRS})
list(INSERT CMAKE_INCLUDE_PATH 0 ${CPSC_LOCAL_INCLUDE_DIRS})

# Search afresh so cached system paths do not defeat newly downloaded packages.
function(cpsc_find_library output)
    unset(cpsc_local_library CACHE)
    find_library(cpsc_local_library NAMES ${ARGN}
        PATHS ${CPSC_LOCAL_LIBRARY_DIRS} NO_DEFAULT_PATH)
    if(cpsc_local_library)
        set(selected "${cpsc_local_library}")
    else()
        unset(cpsc_system_library CACHE)
        find_library(cpsc_system_library NAMES ${ARGN})
        set(selected "${cpsc_system_library}")
    endif()
    set(${output} "${selected}" CACHE FILEPATH "Resolved dependency library" FORCE)
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()

function(cpsc_find_include output name)
    unset(cpsc_local_include CACHE)
    find_path(cpsc_local_include NAMES "${name}"
        PATHS ${CPSC_LOCAL_INCLUDE_DIRS} NO_DEFAULT_PATH)
    if(cpsc_local_include)
        set(${output} "${cpsc_local_include}" CACHE PATH "Local dependency headers" FORCE)
        set(${output} "${cpsc_local_include}" PARENT_SCOPE)
    elseif(DEFINED ${output} AND "${${output}}" MATCHES "^${CPSC_DEPS_ROOT}/")
        unset(${output} CACHE)
        unset(${output} PARENT_SCOPE)
    endif()
endfunction()

unset(cpsc_local_llvm CACHE)
find_path(cpsc_local_llvm LLVMConfig.cmake PATHS ${cpsc_local_prefixes}
    PATH_SUFFIXES lib/cmake/llvm cmake NO_DEFAULT_PATH)
if(cpsc_local_llvm)
    set(LLVM_DIR "${cpsc_local_llvm}" CACHE PATH "LLVM CMake package directory" FORCE)
    set(LLVM_DIR "${cpsc_local_llvm}")
elseif(LLVM_DIR MATCHES "^${CPSC_DEPS_ROOT}/")
    unset(LLVM_DIR CACHE)
    unset(LLVM_DIR)
endif()
# Config-mode dependencies also need to override earlier system cache entries.
unset(cpsc_local_zstd CACHE)
find_path(cpsc_local_zstd zstdConfig.cmake PATHS ${cpsc_local_prefixes}
    PATH_SUFFIXES lib/cmake/zstd "lib/${CMAKE_LIBRARY_ARCHITECTURE}/cmake/zstd"
    NO_DEFAULT_PATH)
if(cpsc_local_zstd)
    set(zstd_DIR "${cpsc_local_zstd}" CACHE PATH "zstd CMake package directory" FORCE)
    set(zstd_DIR "${cpsc_local_zstd}")
elseif(zstd_DIR MATCHES "^${CPSC_DEPS_ROOT}/")
    unset(zstd_DIR CACHE)
    unset(zstd_DIR)
endif()
cpsc_find_library(ZLIB_LIBRARY_RELEASE z)
cpsc_find_library(zstd_LIBRARY zstd zstd_static)
cpsc_find_library(zstd_STATIC_LIBRARY libzstd.a libzstd_static.a)
cpsc_find_library(Terminfo_LIBRARIES terminfo tinfo curses ncurses ncursesw)
cpsc_find_library(FFI_LIBRARIES ffi)
cpsc_find_library(FFI_STATIC_LIBRARIES libffi.a)
cpsc_find_library(LibEdit_LIBRARIES edit)
cpsc_find_library(LIBXML2_LIBRARY xml2)
cpsc_find_include(ZLIB_INCLUDE_DIR zlib.h)
cpsc_find_include(zstd_INCLUDE_DIR zstd.h)
cpsc_find_include(FFI_INCLUDE_DIRS ffi.h)
cpsc_find_include(LibEdit_INCLUDE_DIRS histedit.h)
cpsc_find_include(LIBXML2_INCLUDE_DIR libxml/xpath.h)
