{
  "name": "CIE Pseudocode",
  "scopeName": "source.cie-pseudocode",
  "patterns": [
    {
      "include": "#line_comment"
    },
    {
      "include": "#strings"
    },
    {
      "match": "^\\s*(#)(LIB)\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.cpp"
        },
        "2": {
          "name": "keyword.control.directive.pragma.cpp"
        }
      }
    },
    {
      "match": "(?<!\\w)(?:CASE|ENDCASE)(?!\\w)",
      "name": "keyword.control.switch.cpp"
    },
    {
      "match": "(?<!\\w)(?:OTHERWISE)(?!\\w)",
      "name": "keyword.control.default.cpp"
    },
    {
      "match": "(?<!\\w)(?:CONSTANT)(?!\\w)",
      "name": "storage.modifier.const.cpp"
    },
    {
      "match": "(?<!\\w)(?:CLASS|ENDCLASS)(?!\\w)",
      "name": "storage.type.class.cpp"
    },
    {
      "match": "(?<!\\w)(?:PUBLIC)(?!\\w)",
      "name": "storage.type.modifier.access.control.public.cpp"
    },
    {
      "match": "(?<!\\w)(?:PRIVATE)(?!\\w)",
      "name": "storage.type.modifier.access.control.private.cpp"
    },
    {
      "match": "(?<!\\w)(?:TEMPLATE)(?!\\w)",
      "name": "storage.type.template.cpp"
    },
    {
      "match": "(?<!\\w)(?:OPERATOR)(?!\\w)",
      "name": "keyword.other.operator.overload.cpp"
    },
    {
      "match": "(?<!\\w)(?:OVERLOAD)(?!\\w)",
      "name": "storage.modifier.cpp"
    },
    {
      "match": "(?<!\\w)(?:EXTERN)(?!\\w)",
      "name": "storage.modifier.specifier.extern.cpp"
    },
    {
      "match": "(?<!\\w)(?:EXTERN_FUNCTION|EXTERN_PROCEDURE)(?!\\w)",
      "name": "storage.modifier.cpp"
    },
    {
      "match": "(?<!\\w)(?:INCLUDE_OBJ)(?!\\w)",
      "name": "keyword.control.directive.include.cpp"
    },
    {
      "match": "\\.\\.\\.",
      "name": "punctuation.vararg-ellipses.cpp"
    },
    {
      "match": "(?<!\\w)(?:TRY|ENDTRY)(?!\\w)",
      "name": "keyword.control.try.cpp"
    },
    {
      "match": "(?<!\\w)CATCH(?!\\w)",
      "name": "keyword.control.catch.cpp"
    },
    {
      "match": "(?<!\\w)THROW(?!\\w)",
      "name": "keyword.control.throw.cpp"
    },
    {
      "match": "(?<!\\w)(?:IF|THEN|ELSE|ENDIF|WHILE|DO|ENDWHILE|REPEAT|UNTIL|FOR|TO|STEP|NEXT|RETURN|CALL|NEW|DELETE)(?!\\w)",
      "name": "keyword.control.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)(?:INCLUDE|GLOBAL|ENDGLOBAL|DECLARE|TYPE|ENDTYPE|FUNCTION|ENDFUNCTION|PROCEDURE|ENDPROCEDURE|RETURNS|BYREF|BYVAL|OF)(?!\\w)",
      "name": "storage.modifier.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)(?:INTEGER|REAL|BOOLEAN|STRING|CHAR|ARRAY|C_INT|C_CHAR|C_STRING|C_DOUBLE|C_TYPE)(?!\\w)",
      "name": "storage.type.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)(?:TRUE|FALSE)(?!\\w)",
      "name": "constant.language.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)(?:INPUT|OUTPUT|OPENFILE|READFILE|WRITEFILE|CLOSEFILE|READ|WRITE|APPEND)(?!\\w)",
      "name": "keyword.other.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)(?:LENGTH|MID|RIGHT|LEFT|LCASE|UCASE|ASC|CHR|IS_NUM|NUM_TO_STR|STR_TO_NUM|EOF)(?!\\w)(?=\\s*\\()",
      "name": "entity.name.function.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)(?:DIV|MOD|AND|OR|NOT)(?!\\w)",
      "name": "keyword.operator.word.cie-pseudocode"
    },
    {
      "match": "<-",
      "name": "keyword.operator.assignment.cpp"
    },
    {
      "match": "<>|<=|>=|[+*/=&^<>-]",
      "name": "keyword.operator.cie-pseudocode"
    },
    {
      "match": "(?<!\\w)\\d+(?:\\.\\d*)?(?!\\w)",
      "name": "constant.numeric.cie-pseudocode"
    },
    {
      "match": "\\b[A-Za-z][A-Za-z0-9_]*(?=\\s*\\()",
      "name": "entity.name.function.cie-pseudocode"
    },
    {
      "match": "[()]",
      "name": "punctuation.section.parens.cie-pseudocode"
    },
    {
      "match": "[\\[\\]]",
      "name": "punctuation.section.brackets.cie-pseudocode"
    },
    {
      "match": ",",
      "name": "punctuation.separator.delimiter.comma.cie-pseudocode"
    },
    {
      "match": "[:.]",
      "name": "punctuation.separator.cie-pseudocode"
    }
  ],
  "repository": {
    "line_comment": {
      "begin": "(//)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment.cie-pseudocode"
        }
      },
      "endCaptures": {},
      "name": "comment.line.double-slash.cie-pseudocode",
      "patterns": []
    },
    "strings": {
      "patterns": [
        {
          "match": "'''",
          "name": "string.quoted.single.cie-pseudocode"
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.cie-pseudocode"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.cie-pseudocode"
            }
          },
          "name": "string.quoted.double.cie-pseudocode",
          "patterns": []
        },
        {
          "begin": "'",
          "end": "'|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.cie-pseudocode"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.cie-pseudocode"
            }
          },
          "name": "string.quoted.single.cie-pseudocode",
          "patterns": []
        }
      ]
    }
  }
}
