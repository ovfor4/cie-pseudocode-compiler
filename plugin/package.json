{
  "name": "cie-pseudocode",
  "displayName": "CIE Pseudocode",
  "description": "CIE pseudocode highlighting, Tab indentation and bracket checking for .cps files.",
  "version": "0.1.0",
  "publisher": "ovfor4",
  "author": "_ov4",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovfor4/cie-pseudocode-compiler.git",
    "directory": "plugin"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "scripts": {
    "check": "node --check src/extension.js && node --check src/indentation.js && node --check src/lexical.js && node --check src/brackets.js",
    "test": "node --test test/*.test.js",
    "package": "npm run check && npm test && vsce package --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "cie-pseudocode",
        "aliases": [
          "CIE Pseudocode",
          "cie-pseudocode"
        ],
        "extensions": [
          ".cps"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[cie-pseudocode]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.autoIndent": "full",
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ovfor4.cie-pseudocode",
        "editor.bracketPairColorization.enabled": true,
        "editor.bracketPairColorization.independentColorPoolPerBracketType": false
      }
    },
    "grammars": [
      {
        "language": "cie-pseudocode",
        "scopeName": "source.cie-pseudocode",
        "path": "./syntaxes/cie-pseudocode.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
